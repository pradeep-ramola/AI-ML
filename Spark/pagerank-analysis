      "source": [
        "## PageRank implementation in PySpark"
      ],
      "metadata": {
        "id": "JAMV765ZqpMY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "def run_pagerank(links_rdd, damping=0.85, max_iter=100, tol=1e-6):\n",
        "    ranks = links_rdd.mapValues(lambda _: 1.0 / N)\n",
        "\n",
        "    for i in range(max_iter):\n",
        "        contributions = (\n",
        "            links_rdd\n",
        "            .join(ranks)\n",
        "            .flatMap(lambda x: [(dst, x[1][1] / len(x[1][0])) for dst in x[1][0]])\n",
        "        )\n",
        "\n",
        "        new_ranks = (\n",
        "            contributions\n",
        "            .reduceByKey(lambda x, y: x + y)\n",
        "            .mapValues(lambda c: damping * c + (1 - damping) / N)\n",
        "        )\n",
        "\n",
        "        diff = (\n",
        "            ranks.join(new_ranks)\n",
        "            .map(lambda x: abs(x[1][0] - x[1][1]))\n",
        "            .sum()\n",
        "        )\n",
        "\n",
        "        ranks = new_ranks\n",
        "\n",
        "        if diff < tol:\n",
        "            return ranks, i + 1\n",
        "\n",
        "    return ranks, max_iter\n"
      ],
      "metadata": {
        "id": "0xeIJU2jqFtn"
      },
      "execution_count": null,
      "outputs": []
