      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "def parse_line(line):\n",
        "    node, targets = line.split(\":\")\n",
        "    node = int(node.strip())\n",
        "    targets = eval(targets.strip())\n",
        "    return (node, targets)\n",
        "\n",
        "lines = sc.textFile(\"pagelinks.txt\")\n",
        "links = lines.map(parse_line).cache()\n",
        "\n",
        "N = links.count()\n",
        "print(\"Total nodes:\", N)\n",
        "\n",
        "\n",
        "edges = links.flatMap(lambda x: [(x[0], dst) for dst in x[1]]).cache()\n",
        "\n",
        "print(\"Preview:\")\n",
        "links.take(5)\n"
      ],
